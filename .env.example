# ───── پایه ─────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───── دیتابیس ─────
DATABASE_URL=postgresql://avin:avin@localhost:5432/avinapps?schema=public

# ───── احراز هویت (Auth.js) ─────
# با دستور: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# کلید رمزنگاری مقادیر حساس در DB (۳۲ بایت base64) — openssl rand -base64 32
ENCRYPTION_KEY=change-me

# ───── ادمین اولیه (Seed) ─────
SEED_ADMIN_MOBILE=09120000000
SEED_ADMIN_EMAIL=admin@avinapps.ir
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ───── پیامک ─────
# console | kavenegar
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=avinapps-otp

# ───── درگاه پرداخت ─────
# mock | zarinpal
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# ───── ذخیره‌سازی فایل ─────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ───── پشتیبان‌گیری ─────
BACKUP_DIR=./storage/backups
BACKUP_KEEP=14

# ───── لایسنس (Ed25519، base64 DER) ─────
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# ───── کارهای زمان‌بندی‌شده (cron) ─────
# openssl rand -hex 24
CRON_SECRET=change-me
# موبایل مدیر برای پیامک اطلاع درخواست دمو (قابل تنظیم از پنل هم هست)
ADMIN_NOTIFY_MOBILE=

# ───── Docker ─────
POSTGRES_USER=avin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=avinapps

# فقط برای تست/استیجینگ: فعال‌سازی درگاه آزمایشی در production (هرگز در سایت اصلی)
ALLOW_MOCK_PAYMENT=false
